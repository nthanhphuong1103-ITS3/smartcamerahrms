<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiosk_bg"
    tools:context=".MainActivity">

    <!-- 1. GIAO DIỆN CHÍNH 3 CỘT (LANDSCAPE) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- THANH TIÊU ĐỀ TRÊN CÙNG (HEADER) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- Logo & Nút bấm bí mật mở Admin Settings (Nhấp 5 lần) -->
            <LinearLayout
                android:id="@+id/layoutLogoAdmin"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <View
                    android:id="@+id/dotOnlineStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_camera_container"
                    android:backgroundTint="@color/neon_green" />

                <ImageView
                    android:id="@+id/ivHeaderLogo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_logo_badge"
                    android:padding="2dp"
                    android:src="@drawable/ic_logo_app"
                    android:contentDescription="Smart Camera HRMS Logo"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.05"
                    android:text="SMART CAMERA HRMS"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvServerIpBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@color/kiosk_surface_light"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="192.168.5.99"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Đồng hồ điện tử chính giữa -->
            <TextView
                android:id="@+id/tvDigitalClock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="11:45:00 • Thứ Năm, 15/10/2026"
                android:textColor="@color/neon_cyan"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 3 Nút chọn ca làm việc (Tự động / Vào ca / Tan ca) - Ẩn theo yêu cầu -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnShiftAuto"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="TỰ ĐỘNG"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnShiftIn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="VÀO CA"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnShiftOut"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="TAN CA"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nút làm mới / Reset -->
            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card_rounded"
                android:contentDescription="Làm mới"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- BA CỘT CHÍNH (BODY GRID) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- ========== CỘT 1 (BÊN TRÁI): THÔNG TIN CÁ NHÂN VỪA CHẤM ========== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.29"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="THÔNG TIN CÁ NHÂN"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Khối Avatar tròn & Họ tên -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgPersonalAvatar"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@color/kiosk_surface_light"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_launcher_round"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="@color/kiosk_border_active"
                        app:strokeWidth="2.5dp" />

                    <TextView
                        android:id="@+id/tvPersonalName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="---"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/kiosk_border" />

                <!-- Bảng các trường thông tin chi tiết -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. Mã số nhân viên -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mã NV:"
                            android:textColor="@color/text_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvPersonalCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="---"
                            android:textColor="@color/neon_cyan"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 2. Vị trí / Chức danh -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Chức vụ:"
                            android:textColor="@color/text_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvPersonalPosition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="---"
                            android:textColor="@color/text_primary"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 3. Vị trí làm việc -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nơi làm:"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvPersonalWorkplace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="---"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 4. Phòng ban -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Bộ phận:"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvPersonalDept"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="---"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 5. Giờ chấm -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Giờ:"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvPersonalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:--:--"
                            android:textColor="@color/neon_cyan"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 6. Tỉ lệ khớp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Khớp:"
                            android:textColor="@color/text_muted"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/tvPersonalConfidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="---"
                            android:textColor="@color/neon_green"
                            android:textSize="9.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- View ẩn phụ để giữ tương thích code cũ -->
                <TextView
                    android:id="@+id/tvPersonalRoleDept"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ========== CỘT 2 (CHÍNH GIỮA): CAMERA LIVE VIEW ========== -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.42"
                android:background="@drawable/bg_camera_container"
                android:clipToOutline="true">

                <!-- Luồng CameraX Preview -->
                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreviewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Lớp phủ vẽ khung Neon Cyberpunk theo khuôn mặt -->
                <com.hrms.kiosk.camera.FaceTrackerOverlayView
                    android:id="@+id/faceOverlayView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Thanh thông báo trạng thái dưới chân Camera -->
                <LinearLayout
                    android:id="@+id/layoutStatusBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#CC0A0F1D"
                    android:gravity="center"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvCameraStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Camera đang hoạt động • Nhìn thẳng vào khung hình"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- ========== CỘT 3 (BÊN PHẢI): LỊCH SỬ CHẤM CÔNG HÔM NAY ========== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.29"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Header thẻ Lịch sử chấm công hôm nay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.05"
                        android:text="CHẤM CÔNG HÔM NAY"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTodayCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/kiosk_surface_light"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="0 lượt"
                        android:textColor="@color/neon_cyan"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/kiosk_border" />

                <!-- Danh sách cuộn các ca trong ngày của riêng nhân viên này -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tvTodayEmptyLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="Chưa có lượt chấm công hôm nay"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEmployeeTodayLogs"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="vertical"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- View ẩn phụ để giữ tương thích ViewBinding với landscape / code cũ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvTotalScansCount"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTodayLogs"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- 2. POPUP MODAL NHẬN DIỆN THÀNH CÔNG (1 Ô AVATAR DUY NHẤT CHUẨN 1:1 WEB) -->
    <FrameLayout
        android:id="@+id/layoutPopupResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9040914"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <!-- Thẻ Popup trung tâm bo góc 22dp viền phát sáng -->
        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_popup_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- Huy hiệu xác thực trên cùng: Ring checkmark + ĐIỂM DANH THÀNH CÔNG -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_popup_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_verified_badge"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPopupStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.04"
                    android:text="ĐIỂM DANH THÀNH CÔNG"
                    android:textColor="@color/neon_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 1 Ô Avatar Đơn Trung Tâm 112x112dp kèm Tích Xanh Xác Thực -->
            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginTop="14dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgPopupAvatar"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@color/kiosk_surface_light"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher_round"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/neon_green"
                    app:strokeWidth="3.5dp" />

                <!-- Tích xanh xác thực tinh tế góc dưới - phải -->
                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_verified_badge"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Họ tên in hoa lớn & Mã nhân viên pill cyan -->
            <TextView
                android:id="@+id/tvPopupName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="NGUYỄN VĂN A"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPopupEmpId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_code"
                android:paddingHorizontal="14dp"
                android:paddingVertical="3dp"
                android:text="NV001"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Lưới thông tin 4 ô (2 cột x 2 hàng) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <!-- Row 1: Vị trí & Phòng ban -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Ô 1: Vị trí / Chức danh (icon tím) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_detail_item"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VỊ TRÍ / CHỨC DANH"
                            android:textColor="#C084FC"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPopupRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Nhân viên"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Ô 2: Phòng ban (icon cyan) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_detail_item"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PHÒNG BAN"
                            android:textColor="@color/neon_cyan"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPopupDept"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Phòng Kỹ Thuật"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Thời gian & Độ chuẩn xác -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <!-- Ô 3: Thời gian ghi nhận (icon xanh lá) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_detail_item"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="THỜI GIAN GHI NHẬN"
                            android:textColor="@color/neon_green"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPopupTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="11:45:00"
                            android:textColor="#4ADE80"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Ô 4: Độ chuẩn xác (icon vàng) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_detail_item"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐỘ CHUẨN XÁC"
                            android:textColor="#FBBF24"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPopupConfidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Chuẩn xác"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Thanh tiến trình đếm ngược gradient 1.0s -->
            <ProgressBar
                android:id="@+id/progressCountdown"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/progress_countdown_gradient" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tự đóng sau "
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPopupCountdownNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0s"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
