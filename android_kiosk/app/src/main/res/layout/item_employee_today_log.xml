<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Thumbnail ảnh ghi nhận thời điểm chấm -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgShiftThumb"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@color/kiosk_surface_light"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher_round"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:strokeColor="@color/kiosk_border_active"
        app:strokeWidth="1.5dp" />

    <!-- Thứ tự & Giờ chấm -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvShiftSeq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:text="#1"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShiftTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:singleLine="true"
                android:text="08:15"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvShiftCam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="SMART CAMERA HRMS"
            android:textColor="@color/text_muted"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Tag Mới nhất & Badge Vào ca / Tan ca (Xếp dọc chống ép ngang) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvShiftBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/shift_in"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1.5dp"
            android:singleLine="true"
            android:text="Vào ca"
            android:textColor="@color/white"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvShiftLatestTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="#2622C55E"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:singleLine="true"
            android:text="Mới nhất"
            android:textColor="@color/neon_green"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
